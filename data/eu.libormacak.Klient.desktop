[Desktop Entry]
Type=Application
Name=Klient
GenericName=Mail Client
GenericName[cs]=E-mailový klient
GenericName[de]=E-Mail-Programm
Comment=Proton Mail, Gmail, Seznam and IMAP with PGP, an AI assistant and an AI spam filter
Comment[cs]=Proton Mail, Gmail, Seznam a IMAP s PGP, AI asistentem a AI spamfiltrem
Comment[de]=Proton Mail, Gmail, Seznam und IMAP mit PGP, einem KI-Assistenten und einem KI-Spamfilter
Exec=klient %u
Icon=eu.libormacak.Klient
Terminal=false
Categories=GNOME;GTK;Network;Email;
Keywords=mail;email;proton;gmail;imap;pgp;gpg;
Keywords[cs]=pošta;e-mail;email;proton;gmail;seznam;imap;pgp;gpg;
Keywords[de]=Post;E-Mail;Mail;Proton;Gmail;IMAP;PGP;GPG;
StartupNotify=true
MimeType=x-scheme-handler/mailto;
DBusActivatable=false
