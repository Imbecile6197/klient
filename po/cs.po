#: internal/ai/claude.go
msgid "the model refused to process the request"
msgstr "model odmítl požadavek zpracovat"

#: internal/ai/claude.go
msgid "the model's answer was cut off (max_tokens)"
msgstr "odpověď modelu byla oříznuta (max_tokens)"

#: internal/ai/errors.go
msgid "Local AI is not ready yet. In Preferences → AI, click “Install” next to Ollama and download a model."
msgstr "Lokální AI ještě není připravená. V Předvolbách → AI klikněte u Ollamy na „Nainstalovat“ a stáhněte model."

#: internal/ai/errors.go internal/ollama/runtime.go
msgid "Ollama is not installed"
msgstr "Ollama není nainstalovaná"

#: internal/ai/errors.go
msgid "The Anthropic account has no credit. Add some in the Billing section."
msgstr "Na účtu Anthropic není kredit. Nahrajte ho v sekci Billing."

#: internal/ai/errors.go
msgid "The Gemini API is not enabled in the Google Cloud project the key belongs to. Enable it (the Enable button) and try again in a few minutes – or create a new key in Google AI Studio, which enables the API automatically."
msgstr "V projektu Google Cloud, ke kterému klíč patří, není zapnuté Gemini API. Zapněte ho (tlačítko Povolit) a za pár minut to zkuste znovu – nebo si vytvořte nový klíč v Google AI Studiu, kde se API zapne samo."

#: internal/ai/errors.go
msgid "The Mistral account has no active plan or credit. Choose a plan (the free “Experiment” plan works too) in the Mistral console."
msgstr "Účet Mistral nemá aktivní platební tarif nebo kredit. Zvolte tarif (i bezplatný „Experiment“) v konzoli Mistral."

#: internal/ai/errors.go
msgid "The OpenAI account has no credit. The API is billed separately from a ChatGPT subscription – add credit in the billing settings."
msgstr "Na účtu OpenAI není kredit. API se platí zvlášť od předplatného ChatGPT – nahrajte kredit v nastavení fakturace."

#: internal/ai/errors.go
msgid "The key is invalid or has been revoked. Create a new one and paste it again."
msgstr "Klíč je neplatný nebo byl zrušen. Vytvořte nový a vložte ho znovu."

#: internal/ai/errors.go
msgid "The local model did not answer in time. It is slow on a processor without a graphics card – try a shorter text or a smaller model."
msgstr "Lokální model nestihl odpovědět. Na procesoru bez grafické karty je pomalý – zkuste kratší text nebo menší model."

#: internal/ai/errors.go
msgid "The request limit or quota has been exceeded. Try again later, or check the limits of your account."
msgstr "Překročen limit požadavků nebo kvóta. Zkuste to později, případně zkontrolujte limity účtu."

#: internal/ai/errors.go
msgid "The selected local model is not downloaded. Download it in Preferences → AI (Local AI)."
msgstr "Zvolený lokální model není stažený. Stáhněte ho v Předvolbách → AI (Lokální AI)."

#: internal/ai/errors.go
msgid "The selected model no longer exists or your account has no access to it. Choose another one in Preferences → AI with the model list button."
msgstr "Zvolený model už neexistuje nebo k němu váš účet nemá přístup. Vyberte jiný v Předvolbách → AI tlačítkem se seznamem modelů."

#: internal/ai/errors.go
msgid "There is not enough memory left for the local model. Close demanding applications or choose a smaller model."
msgstr "Na lokální model nezbývá dost paměti. Zavřete náročné aplikace nebo zvolte menší model."

